{
  "expo": {
    "name": "KeyPrime Sales",
    "slug": "keyprime-sales-management",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-square.png",
    "scheme": "keyprimesales",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.keyprime.salesmanagement"
    },
    "android": {
      "package": "com.keyprime.salesmanagement",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/app-icon-square.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/app-icon-square.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/keyprime-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
